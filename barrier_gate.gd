extends Node3D
class_name BarrierGate

# =====================================================================
# BarrierGate
# ---------------------------------------------------------------------
# Раньше тип ворот (A/B/C) НИГДЕ не хранился на самих воротах - он
# просто выводился из того, какую сцену (small/medium/big) BarrierManager
# решил заспавнить для буквы из паттерна-строки. Это ДВА разных
# источника правды для одного и того же (буква в строке сценария и
# scene-slot в инспекторе BarrierManager), и если они разъезжались
# (например, остались старые данные сценария в .tscn после правки
# скрипта) - ворота МОЛЧА получали не тот тип, никакой ошибки не было,
# просто игрок внезапно врезался "непонятно почему".
#
# Теперь ворота сами знают свой тип - повесь этот скрипт на корневой
# узел каждой сцены ворот (SmallBarrier/MediumBarrier/BigBarrier) и
# выставь gate_type в инспекторе. BarrierManager при спавне теперь
# СНАЧАЛА проверяет это поле у заспавненного инстанса и использует его
# как единственный источник правды для проверки столкновений - буква
# из паттерна используется только чтобы решить, ИЗ КАКОЙ сцены спавнить,
# а что происходит "по факту" всегда решает сам объект.
# =====================================================================

@export_enum("A", "B", "C") var gate_type: String = "A"
